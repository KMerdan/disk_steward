{
  "schema": "mcp-readonly-contract-v1",
  "server": {
    "name": "disk-witness-mcp",
    "title": "Disk Steward",
    "version": "1.0.0",
    "instructions": "Read local Disk Steward evidence only. Treat evidence states, confidence and limitations as authoritative. Review items are for a person to review; never imply anything is safe to delete. For what can be cleaned, call list_review_items with the scope named as get_health shows it (or caches), then get_review_item_evidence for one item."
  },
  "protocol_versions": [
    "2026-07-28",
    "2025-11-25",
    "2025-06-18",
    "2025-03-26",
    "2024-11-05"
  ],
  "transport": "stdio",
  "capabilities": {
    "tools": true,
    "resources": true,
    "prompts": false,
    "logging": false,
    "sampling": false
  },
  "tools": [
    {
      "name": "get_storage_summary",
      "title": "Storage summary",
      "description": "Return bounded current volume and monitored-scope totals with freshness and limitations.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "annotations": {
        "title": "Storage summary",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_health",
      "title": "Disk Steward health",
      "description": "Return the stores' sizes and caps, the latest review of each scope, the change journal's state and any legacy evidence.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "annotations": {
        "title": "Disk Steward health",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "explain_growth",
      "title": "Explain growth",
      "description": "Explain growth for a bounded time range: the capacity change, measured object deltas, the unexplained remainder and changed folders.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "through": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "path_detail": {
            "type": "string",
            "enum": [
              "full",
              "basename",
              "hashed"
            ]
          }
        },
        "required": [
          "from",
          "through"
        ]
      },
      "annotations": {
        "title": "Explain growth",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "list_review_items",
      "title": "List review items",
      "description": "List the latest review's ranked items with size, evidence state, recreate class and the owning tool's cleanup command; never a deletion instruction. scope is caches, a folder's path, or the scope name get_health shows.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "path_detail": {
            "type": "string",
            "enum": [
              "full",
              "basename",
              "hashed"
            ]
          }
        }
      },
      "annotations": {
        "title": "List review items",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "list_largest_objects",
      "title": "List largest objects",
      "description": "List the largest measured objects (build output, environments, caches), optionally within one review scope, named as for list_review_items.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "path_detail": {
            "type": "string",
            "enum": [
              "full",
              "basename",
              "hashed"
            ]
          }
        }
      },
      "annotations": {
        "title": "List largest objects",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_review_item_evidence",
      "title": "Review item evidence",
      "description": "Return one review item's full evidence: why it may be disposable, reasons to keep it, its commands and a live check.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "path_detail": {
            "type": "string",
            "enum": [
              "full",
              "basename",
              "hashed"
            ]
          }
        },
        "required": [
          "item_id"
        ]
      },
      "annotations": {
        "title": "Review item evidence",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "measure_path",
      "title": "Measure a folder",
      "description": "Measure one folder inside the configured scopes within 15 s and 500,000 entries; joins a running review instead of starting a second walk, and stores nothing.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "path_detail": {
            "type": "string",
            "enum": [
              "full",
              "basename",
              "hashed"
            ]
          }
        },
        "required": [
          "path"
        ]
      },
      "annotations": {
        "title": "Measure a folder",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "list_active_agent_sessions",
      "title": "Active agent sessions",
      "description": "Return active authenticated agent task contexts and the folders their workspaces saw change, without claiming they are file writers.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      },
      "annotations": {
        "title": "Active agent sessions",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_task_impact",
      "title": "Task impact",
      "description": "Summarize the folders that changed in a registered session's workspace during its window, with the objects there; a correlation, never a claim about which process wrote.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "type": "string",
            "maxLength": 256
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "from": {
            "type": "string"
          },
          "through": {
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ]
      },
      "annotations": {
        "title": "Task impact",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "export_evidence",
      "title": "Export evidence",
      "description": "Return a bounded inline export of the steward evidence for a window, plus the legacy evidence read-only when it fits.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "through": {
            "type": "string"
          },
          "path_detail": {
            "type": "string",
            "enum": [
              "full",
              "basename",
              "hashed"
            ]
          },
          "max_events": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        },
        "required": [
          "from",
          "through"
        ]
      },
      "annotations": {
        "title": "Export evidence",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ],
  "resources": [
    {
      "uri": "disk-steward://status",
      "name": "Disk Steward service status",
      "mimeType": "application/json"
    },
    {
      "uri": "disk-steward://evidence-guide",
      "name": "Disk Steward evidence interpretation guide",
      "mimeType": "text/markdown"
    }
  ],
  "response_policy": {
    "max_items": 10000,
    "max_bytes": 4194304,
    "path_detail": "basename",
    "record_file_contents": false,
    "capture_environment": false,
    "errors": "tool-result-for-execution"
  }
}
