{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disk-steward.local/schemas/retention-policy-v1.schema.json",
  "title": "Disk Steward Retention Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "raw_event_days", "hourly_summary_days", "daily_summary_days", "max_database_bytes", "write_coalesce_seconds", "preserve_unreviewed_anomalies"],
  "properties": {
    "schema": {"const": "retention-policy-v1"},
    "raw_event_days": {"type": "integer", "minimum": 1, "maximum": 30},
    "hourly_summary_days": {"type": "integer", "minimum": 7, "maximum": 180},
    "daily_summary_days": {"type": "integer", "minimum": 30, "maximum": 730},
    "max_database_bytes": {"type": "integer", "minimum": 10485760, "maximum": 10737418240},
    "write_coalesce_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
    "preserve_unreviewed_anomalies": {"type": "boolean"}
  }
}

