# BEGIN DISK STEWARD MANAGED v1
[mcp_servers.disk_steward]
command = "/Applications/Disk Steward.app/Contents/MacOS/disk-witness-mcp"
args = []
enabled = true
startup_timeout_sec = 10
tool_timeout_sec = 60
enabled_tools = ["get_storage_summary", "explain_growth", "get_provenance", "list_active_writers", "get_task_impact", "find_cleanup_candidates", "export_evidence"]
default_tools_approval_mode = "auto"
# END DISK STEWARD MANAGED v1
