#!/bin/zsh
# Removes only the disk_steward MCP entry (and the Disk Steward-owned Codex
# plugin) for one CLI client. Recoverable (TASK-561): the removed files go into a
# timestamped backup directory with a manifest, a failure mid-way restores them,
# an entry carrying user additions is refused rather than deleted, and
# `Scripts/Integration/rollback` puts a backup back on request.
set -euo pipefail

client=""
config_root=""
dry_run=0

usage() {
  print -u2 "usage: uninstall --client codex|claude --config-root ABSOLUTE_PATH [--dry-run]"
  exit 64
}

while (( $# > 0 )); do
  case "$1" in
    --client) (( $# >= 2 )) || usage; client="$2"; shift 2 ;;
    --config-root) (( $# >= 2 )) || usage; config_root="$2"; shift 2 ;;
    --dry-run) dry_run=1; shift ;;
    *) usage ;;
  esac
done

[[ "$client" == "codex" || "$client" == "claude" ]] || usage
[[ "$config_root" == /* && "$config_root" != *$'\n'* ]] || usage

if (( dry_run )); then
  print "Would remove only the disk_steward MCP entry for $client from $config_root."
  print "Disk Steward evidence and unrelated client settings would remain untouched."
  print "A recoverable backup with a manifest would be written under $config_root/.disk-steward-backups/ first."
  exit 0
fi

[[ -d "$config_root" ]] || { print "Nothing installed at $config_root"; exit 0; }
script_dir=${0:A:h}
source "$script_dir/backup-lib.zsh"
timestamp=uninstalled-$(date -u +%Y%m%dT%H%M%SZ)-$$
backups_dir="$config_root/.disk-steward-backups"
backup_root="$backups_dir/$timestamp"
mkdir -p "$backup_root"
chmod 700 "$backups_dir" "$backup_root"

if [[ "$client" == "codex" ]]; then
  config_file="$config_root/config.toml"
  plugin_target="$config_root/plugins/disk-steward"
else
  config_file="$config_root/.mcp.json"
  plugin_target=""
fi

config_backed=0
plugin_moved=0
undo_done=0
undo() {
  local exit_status=$?
  trap - ZERR EXIT
  setopt localoptions noerrexit noerrreturn
  (( undo_done )) && exit $exit_status
  undo_done=1
  if (( exit_status != 0 )); then
    local -a failures
    failures=()
    local restored=0
    if (( config_backed )) && [[ -f "$backup_root/${config_file:t}" ]]; then
      if ! verify_unchanged "$backup_root/${config_file:t}" "$config_file"; then
        restore_file "$backup_root/${config_file:t}" "$config_file" && restored=1 || failures+=("could not restore ${config_file:t} from $backup_root/${config_file:t}")
      fi
    fi
    if (( plugin_moved )) && [[ -e "$backup_root/disk-steward-plugin" ]]; then
      rm -rf "$plugin_target"
      mv "$backup_root/disk-steward-plugin" "$plugin_target" && restored=1 || failures+=("could not restore the plugin from $backup_root/disk-steward-plugin")
    fi
    if (( ${#failures} > 0 )); then
      manifest_finish "$backup_root" "restore-failed"
      print -u2 "uninstall: step failed (exit $exit_status) and the automatic restore did not complete:"
      local failure
      for failure in "${failures[@]}"; do print -u2 "  - $failure"; done
      print -u2 "uninstall: the removed copies stay in $backup_root; restore them with: $script_dir/rollback --client $client --config-root $config_root --backup ${backup_root:t} --force"
      exit_status=70
    elif (( restored )); then
      manifest_finish "$backup_root" "failed-and-restored"
      print -u2 "uninstall: step failed (exit $exit_status); restored the $client configuration from $backup_root"
    else
      manifest_finish "$backup_root" "refused-nothing-changed"
      print -u2 "uninstall: step failed (exit $exit_status); nothing was changed"
    fi
  fi
  exit $exit_status
}
trap undo ZERR EXIT

manifest_begin "$backup_root" "uninstall" "$client" ""
if [[ -f "$config_file" ]]; then
  cp -p "$config_file" "$backup_root/${config_file:t}"
  manifest_file "$backup_root" "${config_file:t}" "$config_file" existed
  config_backed=1
else
  manifest_file "$backup_root" "${config_file:t}" "$config_file" absent
fi

if [[ "$client" == "codex" ]]; then
  if [[ -f "$config_file" ]]; then
    begins=$(grep -c '^# BEGIN DISK STEWARD MANAGED v1$' "$config_file" || true)
    ends=$(grep -c '^# END DISK STEWARD MANAGED v1$' "$config_file" || true)
    if (( begins != ends || begins > 1 )); then
      print -u2 "Refusing to edit $config_file because its Disk Steward managed markers are malformed."
      exit 65
    fi
    temporary=$(mktemp "$config_root/.config.toml.disk-steward.XXXXXX")
    awk '
      $0 == "# BEGIN DISK STEWARD MANAGED v1" { managed=1; next }
      $0 == "# END DISK STEWARD MANAGED v1" { managed=0; next }
      !managed { print }
    ' "$config_file" > "$temporary"
    chmod 600 "$temporary"
    verify_unchanged "$backup_root/${config_file:t}" "$config_file" || { rm -f "$temporary"; print -u2 "uninstall: $config_file changed while it was being edited; nothing was changed. Retry."; exit 75; }
    mv "$temporary" "$config_file"
  fi
  if [[ -e "$plugin_target" ]]; then
    manifest_plugin "$backup_root" existed
    mv "$plugin_target" "$backup_root/disk-steward-plugin"
    plugin_moved=1
  else
    manifest_plugin "$backup_root" absent
  fi
else
  if [[ -f "$config_file" ]]; then
    /usr/bin/swift "$script_dir/json-config.swift" remove "$config_file"
  fi
fi

manifest_after "$backup_root" "${config_file:t}" "$config_file"
manifest_finish "$backup_root" "uninstalled"
prune_backups "$backups_dir" 10
trap - ZERR EXIT

print "Uninstalled Disk Steward from $client."
print "Recoverable backup: $backup_root"
print "Undo: $script_dir/rollback --client $client --config-root $config_root --backup $timestamp"
