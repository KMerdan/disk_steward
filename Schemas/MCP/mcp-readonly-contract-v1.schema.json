{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disk-steward.local/schemas/mcp-readonly-contract-v1.schema.json",
  "title": "Disk Steward read-only MCP inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "server", "protocol_versions", "transport", "capabilities", "tools", "resources", "response_policy"],
  "properties": {
    "schema": { "const": "mcp-readonly-contract-v1" },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "instructions"],
      "properties": {
        "name": { "const": "disk-witness-mcp" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "instructions": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "protocol_versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "type": "string", "enum": ["2025-06-18", "2025-03-26", "2024-11-05"] }
    },
    "transport": { "const": "stdio" },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools", "resources", "prompts", "logging", "sampling"],
      "properties": {
        "tools": { "const": true },
        "resources": { "const": true },
        "prompts": { "const": false },
        "logging": { "const": false },
        "sampling": { "const": false }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "inputSchema", "annotations"],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "get_storage_summary",
              "get_evidence_lifecycle",
              "list_current_consumers",
              "explain_growth",
              "get_provenance",
              "list_active_agent_sessions",
              "list_active_writers",
              "get_task_impact",
              "find_cleanup_candidates",
              "export_evidence"
            ]
          },
          "description": { "type": "string", "minLength": 1, "maxLength": 512 },
          "inputSchema": { "type": "object" },
          "annotations": {
            "type": "object",
            "additionalProperties": false,
            "required": ["readOnlyHint", "destructiveHint", "idempotentHint", "openWorldHint"],
            "properties": {
              "readOnlyHint": { "const": true },
              "destructiveHint": { "const": false },
              "idempotentHint": { "const": true },
              "openWorldHint": { "const": false }
            }
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri", "name", "mimeType"],
        "properties": {
          "uri": { "type": "string", "pattern": "^disk-steward://" },
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "mimeType": { "type": "string", "enum": ["application/json", "text/markdown"] }
        }
      }
    },
    "response_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_items", "max_bytes", "path_detail", "record_file_contents", "capture_environment", "errors"],
      "properties": {
        "max_items": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "max_bytes": { "type": "integer", "minimum": 1024, "maximum": 4194304 },
        "path_detail": { "type": "string", "enum": ["full", "basename", "hashed"] },
        "record_file_contents": { "const": false },
        "capture_environment": { "const": false },
        "errors": { "type": "string", "enum": ["json-rpc-for-protocol", "tool-result-for-execution"] }
      }
    }
  }
}
