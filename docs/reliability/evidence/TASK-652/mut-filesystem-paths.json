{
 "name": "attribution standardizes paths through the file system",
 "mutations": [
  {
   "file": "Sources/DiskStewardCore/Monitoring/ChangeJournal.swift",
   "replacements": [
    [
     "let standardized = normalized(path)",
     "let standardized = URL(fileURLWithPath: path).standardizedFileURL.path"
    ],
    [
     "guard let root = roots.map(normalized)",
     "guard let root = roots.map({ URL(fileURLWithPath: $0).standardizedFileURL.path })"
    ]
   ]
  }
 ]
}