{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disk-steward.local/schemas/privileged-bridge-status-v1.schema.json",
  "title": "Disk Steward privileged bridge status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "observed_at", "state", "event_gap", "dropped_events", "fallback", "retry", "limitations"],
  "properties": {
    "schema": {"const": "privileged-bridge-status-v1"},
    "observed_at": {"type": "string", "minLength": 20},
    "state": {"type": "string", "enum": ["available", "pending-user-approval", "not-entitled", "not-permitted", "too-many-clients", "overloaded", "dropped-events", "unavailable"]},
    "event_gap": {"type": "boolean"},
    "dropped_events": {"type": "integer", "minimum": 0},
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "method", "maximum_confidence"],
      "properties": {
        "active": {"const": true},
        "method": {"const": "snapshot-fsevents"},
        "maximum_confidence": {"type": "string", "enum": ["inferred", "tool-linked", "unknown"]}
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automatic", "minimum_seconds", "maximum_seconds", "requires_user_action"],
      "properties": {
        "automatic": {"type": "boolean"},
        "minimum_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "maximum_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "requires_user_action": {"type": "boolean"}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
