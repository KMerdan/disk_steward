#!/bin/sh
set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
configuration=${CONFIGURATION:-Debug}

xcodegen generate \
  --spec "$project_root/Config/Packaging/project.yml" \
  --project-root "$project_root" \
  --project "$project_root"

xcodebuild \
  -project "$project_root/DiskSteward.xcodeproj" \
  -scheme DiskSteward \
  -configuration "$configuration" \
  build
