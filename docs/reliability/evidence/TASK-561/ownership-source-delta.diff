+    local -a failures
+    failures=()
+    print -u2 "rollback: applying $backup_name failed (exit $exit_status); putting the previous state back from $save_root"
+    if [[ -f "$save_root/${config_file:t}" ]]; then
+      restore_file "$save_root/${config_file:t}" "$config_file" || failures+=("could not put back ${config_file:t} from $save_root")
+    else
+      rm -f "$config_file" || failures+=("could not remove $config_file")
+    fi
+    if [[ -n "$plugin_target" ]]; then
+      rm -rf "$plugin_target" || failures+=("could not clear $plugin_target")
