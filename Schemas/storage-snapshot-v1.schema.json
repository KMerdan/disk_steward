{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disk-steward.local/schemas/storage-snapshot-v1.schema.json",
  "title": "Disk Steward Storage Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "snapshot_id", "observed_at", "scope", "volumes", "limitations"],
  "properties": {
    "schema": {"const": "storage-snapshot-v1"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "minLength": 1},
    "scope": {"enum": ["whole-volume", "watched-root", "registered-process", "investigation"]},
    "volumes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mount_path", "total_bytes", "available_bytes", "used_bytes", "is_internal", "is_read_only"],
        "properties": {
          "mount_path": {"type": "string", "minLength": 1},
          "total_bytes": {"type": "integer", "minimum": 0},
          "available_bytes": {"type": "integer", "minimum": 0},
          "used_bytes": {"type": "integer", "minimum": 0},
          "is_internal": {"type": "boolean"},
          "is_read_only": {"type": "boolean"}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}

