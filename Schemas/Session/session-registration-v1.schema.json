{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disk-steward.local/schemas/session-registration-v1.schema.json",
  "title": "Disk Steward agent session registration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "registration_id",
    "client",
    "session_id",
    "process",
    "workspace_roots",
    "registered_at",
    "expires_at",
    "lifecycle",
    "authentication",
    "attribution"
  ],
  "properties": {
    "schema": { "const": "session-registration-v1" },
    "registration_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "client": { "type": "string", "enum": ["codex", "claude", "other-local"] },
    "session_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "start_time", "executable_path", "parent_chain"],
      "properties": {
        "pid": { "type": "integer", "minimum": 1 },
        "start_time": { "type": "string", "minLength": 20 },
        "executable_path": { "type": ["string", "null"], "maxLength": 4096 },
        "parent_chain": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pid", "start_time"],
            "properties": {
              "pid": { "type": "integer", "minimum": 1 },
              "start_time": { "type": "string", "minLength": 20 }
            }
          }
        }
      }
    },
    "workspace_roots": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "registered_at": { "type": "string", "minLength": 20 },
    "expires_at": { "type": "string", "minLength": 20 },
    "ended_at": { "type": ["string", "null"], "minLength": 20 },
    "lifecycle": { "type": "string", "enum": ["active", "ended", "expired"] },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "socket_mode", "peer_uid_verified", "challenge_digest", "secret_persisted"],
      "properties": {
        "transport": { "const": "unix-domain-socket" },
        "socket_mode": { "const": "0600" },
        "peer_uid_verified": { "const": true },
        "challenge_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "secret_persisted": { "const": false }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "method", "limitations"],
      "properties": {
        "confidence": { "type": "string", "enum": ["tool-linked", "inferred", "unknown"] },
        "method": { "type": "string", "enum": ["registered-process-tree", "temporal-correlation", "unavailable"] },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    }
  }
}
