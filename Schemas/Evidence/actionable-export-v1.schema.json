{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disk-steward.local/schemas/evidence/actionable-export-v1.schema.json",
  "title": "Disk Steward Actionable Export v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bundle_id", "generated_at", "consistent_view_id", "scope", "files", "brief", "limitations", "privacy"],
  "properties": {
    "schema": {"const": "actionable-export-v1"},
    "bundle_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "consistent_view_id": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["volume_capacity_scope", "file_detail_roots", "exclusions", "detail_coverage", "state_as_of", "last_complete_generation_at", "active_generation", "open_gap_count"],
      "properties": {
        "volume_capacity_scope": {"enum": ["whole-volume-capacity", "selected-volume-capacity"]},
        "file_detail_roots": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "exclusions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "detail_coverage": {"enum": ["complete", "partial", "stale", "unavailable"]},
        "state_as_of": {"type": "string", "minLength": 1},
        "last_complete_generation_at": {"type": ["string", "null"]},
        "active_generation": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["generation_id", "completed_slices", "staged_objects", "has_more"],
          "properties": {
            "generation_id": {"type": "string", "minLength": 1},
            "completed_slices": {"type": "integer", "minimum": 0},
            "staged_objects": {"type": "integer", "minimum": 0},
            "has_more": {"type": "boolean"}
          }
        },
        "open_gap_count": {"type": "integer", "minimum": 0}
      }
    },
    "files": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"enum": ["codex-brief", "summary", "events", "snapshot", "current-state", "provenance", "agent-sessions", "coverage", "lifecycle", "integrity"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sections", "growth_assessment", "inspection_order"],
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 8,
          "items": {"enum": ["evidence-age", "scope", "coverage", "largest-current-consumers", "growth", "cleanup-review-leads", "provenance", "lifecycle", "limitations"]}
        },
        "growth_assessment": {"enum": ["measured-growth", "measured-shrinkage", "measured-no-change", "unavailable"]},
        "inspection_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_file_contents", "contains_environment", "path_detail", "redaction_applied"],
      "properties": {
        "contains_file_contents": {"const": false},
        "contains_environment": {"const": false},
        "path_detail": {"enum": ["full", "basename", "hashed"]},
        "redaction_applied": {"const": true}
      }
    }
  }
}
