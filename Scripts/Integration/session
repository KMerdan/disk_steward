#!/usr/bin/env swift

// Disk Steward session entry point (TASK-562 contract).
//
// A registration binds a task to one long-lived agent process, never to this
// script: `register` requires --process-pid, checks that the process is alive
// and is an ancestor of this script (so a wrapper shell cannot be named by
// accident), and refuses this script's own interpreter. Heartbeats carry the
// lease explicitly; `end` closes the registration. The app validates the
// ancestry again from the socket's kernel peer credentials. Nothing here is
// inferred from MCP traffic and no client hook is installed.

import Darwin
import Foundation

struct Options {
    var operation = ""
    var client = ""
    var sessionID = ""
    var registrationID = ""
    var processPID: Int32 = 0
    var workspaces: [String] = []
    var socket = FileManager.default.homeDirectoryForCurrentUser
        .appendingPathComponent("Library/Application Support/Disk Steward/disk-steward.sock").path
    var leaseSeconds = 7_200
    var dryRun = false
}

enum SessionError: Error, CustomStringConvertible {
    case usage(String)
    case invalid(String)
    case system(String)

    var description: String {
        switch self {
        case let .usage(message), let .invalid(message), let .system(message): message
        }
    }

    var exitCode: Int32 {
        switch self {
        case .usage: 64
        case .invalid: 65
        case .system: 69
        }
    }
}

let usage = """
usage:
  session register --client codex|claude|other-local --session-id ID --workspace PATH [--workspace PATH] --process-pid PID [--lease-seconds N] [--socket PATH] [--dry-run]
  session heartbeat --registration-id UUID [--lease-seconds N] [--socket PATH] [--dry-run]
  session end --registration-id UUID [--socket PATH] [--dry-run]

--process-pid names the long-lived agent process the task belongs to (for a
shell-driven agent, that agent's own PID, not $$ of a transient wrapper). It
must be alive and an ancestor of this command; this script itself is never
registered. Send heartbeats while the task is active and end it when done.
"""

func parse() throws -> Options {
    var options = Options()
    var arguments = Array(CommandLine.arguments.dropFirst())
    guard !arguments.isEmpty else { throw SessionError.usage(usage) }
    options.operation = arguments.removeFirst()
    while !arguments.isEmpty {
        let flag = arguments.removeFirst()
        if flag == "--dry-run" { options.dryRun = true; continue }
        guard !arguments.isEmpty else { throw SessionError.usage("Missing value for \(flag).\n\(usage)") }
        let value = arguments.removeFirst()
        switch flag {
        case "--client": options.client = value
        case "--session-id": options.sessionID = value
        case "--registration-id": options.registrationID = value
        case "--process-pid":
            guard let pid = Int32(value), pid > 0 else { throw SessionError.invalid("process PID must be positive") }
            options.processPID = pid
        case "--workspace": options.workspaces.append(URL(fileURLWithPath: value).standardizedFileURL.path)
        case "--socket": options.socket = value
        case "--lease-seconds":
            guard let lease = Int(value) else { throw SessionError.invalid("lease must be an integer") }
            options.leaseSeconds = lease
        default: throw SessionError.usage("Unknown option: \(flag).\n\(usage)")
        }
    }
    switch options.operation {
    case "register":
        guard ["codex", "claude", "other-local"].contains(options.client),
              !options.sessionID.isEmpty, !options.workspaces.isEmpty
        else { throw SessionError.usage(usage) }
        guard options.processPID > 0 else {
            throw SessionError.usage("register requires --process-pid: the long-lived agent process this task belongs to.\n\(usage)")
        }
        guard (60 ... 86_400).contains(options.leaseSeconds) else {
            throw SessionError.invalid("lease must be between 60 and 86400 seconds")
        }
        try validateProcess(options.processPID)
    case "end", "heartbeat":
        guard UUID(uuidString: options.registrationID) != nil else {
            throw SessionError.invalid("end/heartbeat requires a valid --registration-id")
        }
        guard (60 ... 86_400).contains(options.leaseSeconds) else {
            throw SessionError.invalid("lease must be between 60 and 86400 seconds")
        }
    default: throw SessionError.usage(usage)
    }
    return options
}

struct ProcessInfoRecord { let pid: Int32; let parent: Int32; let name: String }

func processRecord(_ pid: Int32) -> ProcessInfoRecord? {
    var info = kinfo_proc()
    var size = MemoryLayout<kinfo_proc>.stride
    var mib: [Int32] = [CTL_KERN, KERN_PROC, KERN_PROC_PID, pid]
    guard sysctl(&mib, UInt32(mib.count), &info, &size, nil, 0) == 0, size > 0, info.kp_proc.p_pid == pid else { return nil }
    let name = withUnsafePointer(to: &info.kp_proc.p_comm) { pointer in
        pointer.withMemoryRebound(to: CChar.self, capacity: Int(MAXCOMLEN) + 1) { String(cString: $0) }
    }
    return ProcessInfoRecord(pid: pid, parent: info.kp_eproc.e_ppid, name: name)
}

/// The named process must be alive, must not be this script, and must be an
/// ancestor of this script: that is the only relationship the app can also
/// prove from the socket's peer credentials.
func validateProcess(_ pid: Int32) throws {
    guard pid != getpid() else { throw SessionError.invalid("--process-pid must not be this session command itself; name the agent process it runs under.") }
    guard kill(pid, 0) == 0 || errno == EPERM else { throw SessionError.invalid("process \(pid) is not running; a dead process cannot own a task registration.") }
    var current = getpid()
    var depth = 0
    var chain: [String] = []
    while depth < 64, let record = processRecord(current) {
        chain.append("\(record.name)(\(record.pid))")
        if record.parent == pid {
            if let target = processRecord(pid), ["sh", "zsh", "bash", "dash", "fish", "env", "xargs", "swift", "swift-frontend"].contains(target.name) {
                FileHandle.standardError.write(Data("disk-steward-session: warning: \(target.name)(\(pid)) looks like a transient wrapper; if it exits before the task ends, the registration will not attribute later writes. Prefer the agent's own PID.\n".utf8))
            }
            return
        }
        guard record.parent > 1 else { break }
        current = record.parent
        depth += 1
    }
    throw SessionError.invalid("process \(pid) is not an ancestor of this command (chain: \(chain.joined(separator: " <- "))); the app would reject the registration. Run the session command from within the agent process tree and pass that process's PID.")
}

func request(for options: Options) -> [String: Any] {
    let method: String
    let payload: [String: Any]
    switch options.operation {
    case "register":
        method = "sessions/register"
        payload = [
            "client": options.client,
            "session_id": options.sessionID,
            "workspace_roots": options.workspaces,
            "lease_seconds": options.leaseSeconds,
            "process_pid": options.processPID,
        ]
    case "heartbeat":
        method = "sessions/heartbeat"
        payload = ["registration_id": options.registrationID, "lease_seconds": options.leaseSeconds]
    default:
        method = "sessions/end"
        payload = ["registration_id": options.registrationID]
    }
    return [
        "schema": "ipc-request-v1",
        "id": UUID().uuidString.lowercased(),
        "method": method,
        "payload": payload,
    ]
}

func exchange(_ request: [String: Any], socketPath: String) throws -> Data {
    var status = stat()
    guard lstat(socketPath, &status) == 0 else {
        throw SessionError.system("Disk Steward is unavailable at \(socketPath). Open the app and verify Monitoring and Agent Access are enabled.")
    }
    guard status.st_uid == getuid(), status.st_mode & S_IFMT == S_IFSOCK,
          status.st_mode & 0o077 == 0
    else { throw SessionError.system("Refusing an insecure or unowned Disk Steward socket.") }

    let descriptor = Darwin.socket(AF_UNIX, SOCK_STREAM, 0)
    guard descriptor >= 0 else { throw SessionError.system("socket failed: \(String(cString: strerror(errno)))") }
    defer { Darwin.close(descriptor) }
    var address = sockaddr_un()
    address.sun_family = sa_family_t(AF_UNIX)
    let bytes = Array(socketPath.utf8CString)
    guard bytes.count <= MemoryLayout.size(ofValue: address.sun_path) else {
        throw SessionError.invalid("socket path is too long")
    }
    withUnsafeMutablePointer(to: &address.sun_path) { pointer in
        pointer.withMemoryRebound(to: CChar.self, capacity: bytes.count) { buffer in
            for (index, byte) in bytes.enumerated() { buffer[index] = byte }
        }
    }
    let length = socklen_t(MemoryLayout<sa_family_t>.size + bytes.count)
    let connected = withUnsafePointer(to: &address) { pointer in
        pointer.withMemoryRebound(to: sockaddr.self, capacity: 1) { Darwin.connect(descriptor, $0, length) }
    }
    guard connected == 0 else {
        throw SessionError.system("Unable to connect to Disk Steward: \(String(cString: strerror(errno)))")
    }
    var outgoing = try JSONSerialization.data(withJSONObject: request, options: [.sortedKeys])
    outgoing.append(0x0A)
    try outgoing.withUnsafeBytes { raw in
        guard let base = raw.baseAddress else { return }
        var sent = 0
        while sent < raw.count {
            let count = Darwin.write(descriptor, base.advanced(by: sent), raw.count - sent)
            guard count > 0 else { throw SessionError.system("write failed") }
            sent += count
        }
    }
    var response = Data()
    var byte: UInt8 = 0
    while response.count <= 1_048_576 {
        let count = Darwin.read(descriptor, &byte, 1)
        guard count > 0 else { throw SessionError.system("Disk Steward closed the connection without a response.") }
        if byte == 0x0A { return response }
        response.append(byte)
    }
    throw SessionError.system("Disk Steward response exceeded 1 MiB.")
}

do {
    let options = try parse()
    let message = request(for: options)
    if options.dryRun {
        print(String(decoding: try JSONSerialization.data(withJSONObject: message, options: [.prettyPrinted, .sortedKeys]), as: UTF8.self))
    } else {
        let response = try exchange(message, socketPath: options.socket)
        let object = try JSONSerialization.jsonObject(with: response)
        guard let dictionary = object as? [String: Any], dictionary["error"] == nil else {
            throw SessionError.system("Disk Steward rejected the session request: \(String(decoding: response, as: UTF8.self))")
        }
        print(String(decoding: response, as: UTF8.self))
    }
} catch let error as SessionError {
    FileHandle.standardError.write(Data(("disk-steward-session: \(error)\n").utf8))
    exit(error.exitCode)
} catch {
    FileHandle.standardError.write(Data(("disk-steward-session: \(error)\n").utf8))
    exit(69)
}
