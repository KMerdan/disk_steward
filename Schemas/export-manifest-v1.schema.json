{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disk-steward.local/schemas/export-manifest-v1.schema.json",
  "title": "Disk Steward Export Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bundle_id", "created_at", "producer", "requested_range", "files", "limitations", "privacy"],
  "properties": {
    "schema": {"const": "export-manifest-v1"},
    "bundle_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "evidence_schema_version"],
      "properties": {
        "name": {"const": "disk-steward"},
        "version": {"type": "string", "minLength": 1},
        "evidence_schema_version": {"const": 1}
      }
    },
    "requested_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "through"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "through": {"type": "string", "minLength": 1}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"enum": ["codex-brief", "summary", "events", "snapshot", "adapter", "integrity"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_file_contents", "contains_environment", "path_detail"],
      "properties": {
        "contains_file_contents": {"const": false},
        "contains_environment": {"const": false},
        "path_detail": {"enum": ["full", "basename", "hashed"]}
      }
    }
  }
}

