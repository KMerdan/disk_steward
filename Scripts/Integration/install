#!/bin/zsh
# Installs the read-only Disk Steward connector for one CLI client.
#
# Every mutation is recoverable (TASK-561): a timestamped backup directory under
# <config-root>/.disk-steward-backups/ receives the pre-install files and a
# manifest.json with their hashes; a failure at any later step restores exactly
# those files before exiting; `Scripts/Integration/rollback` restores a backup
# on request; only the newest ten backup directories are kept.
set -euo pipefail

client=""
config_root=""
connector=""
dry_run=0

usage() {
  print -u2 "usage: install --client codex|claude --config-root ABSOLUTE_PATH --connector ABSOLUTE_EXECUTABLE [--dry-run]"
  exit 64
}

while (( $# > 0 )); do
  case "$1" in
    --client) (( $# >= 2 )) || usage; client="$2"; shift 2 ;;
    --config-root) (( $# >= 2 )) || usage; config_root="$2"; shift 2 ;;
    --connector) (( $# >= 2 )) || usage; connector="$2"; shift 2 ;;
    --dry-run) dry_run=1; shift ;;
    *) usage ;;
  esac
done

[[ "$client" == "codex" || "$client" == "claude" ]] || usage
[[ "$config_root" == /* && "$connector" == /* ]] || usage
[[ "$config_root" != *$'\n'* && "$connector" != *$'\n'* ]] || usage

if (( dry_run )); then
  print "Would install the read-only Disk Steward connector for $client."
  print "Configuration root: $config_root"
  print "Connector: $connector"
  print "Only the disk-steward MCP entry and the Disk Steward evidence skill would change."
  print "A recoverable backup with a manifest would be written under $config_root/.disk-steward-backups/ first."
  exit 0
fi

[[ -x "$connector" ]] || { print -u2 "Connector is not executable: $connector"; exit 66; }
# Claude Code reads user-scope servers from ~/.claude.json, which this script
# does not edit; --config-root is a project directory for Claude.
if [[ "$client" == "claude" && "${config_root:t}" == ".claude" ]]; then
  print -u2 "install: --config-root for Claude Code is a project directory (its .mcp.json and .claude/skills)."
  print -u2 "install: for every project, use Disk Steward > Settings > Agent Integrations, or: claude mcp add --scope user disk-steward -- $connector"
  exit 64
fi

script_dir=${0:A:h}
repo_root=${script_dir:h:h}
source "$script_dir/backup-lib.zsh"

timestamp=$(date -u +%Y%m%dT%H%M%SZ)-$$
backups_dir="$config_root/.disk-steward-backups"
backup_root="$backups_dir/$timestamp"
mkdir -p "$config_root" "$backup_root"
chmod 700 "$config_root" "$backups_dir" "$backup_root"

# The recoverable artifact beside the configuration is the evidence skill:
# Codex reads user skills from <CODEX_HOME>/skills, Claude Code reads a
# project's .claude/skills (TASK-715).
if [[ "$client" == "codex" ]]; then
  config_file="$config_root/config.toml"
  plugin_target="$config_root/skills/disk-steward-evidence"
else
  config_file="$config_root/.mcp.json"
  plugin_target="$config_root/.claude/skills/disk-steward-evidence"
fi

# Everything below is undone on failure: the backup taken first is the source
# of truth for what "unchanged" means.
config_backed=0
plugin_backed=0
plugin_written=0
config_written=0
undo_done=0
undo() {
  local exit_status=$?
  trap - ZERR EXIT
  setopt localoptions noerrexit noerrreturn
  (( undo_done )) && exit $exit_status
  undo_done=1
  if (( exit_status != 0 )); then
    local -a failures
    failures=()
    local restored=0
    if (( config_written || config_backed )); then
      if [[ -f "$backup_root/${config_file:t}" ]]; then
        if ! verify_unchanged "$backup_root/${config_file:t}" "$config_file"; then
          restore_file "$backup_root/${config_file:t}" "$config_file" && restored=1 || failures+=("could not restore ${config_file:t} from $backup_root/${config_file:t}")
        fi
      elif (( config_written )) && [[ -f "$config_file" ]]; then
        rm -f "$config_file" && restored=1 || failures+=("could not remove the partially written $config_file")
      fi
    fi
    if [[ -n "$plugin_target" ]] && (( plugin_written || plugin_backed )); then
      if [[ "${DISK_STEWARD_INTEGRATION_FAULT:-}" == "undo-plugin" && "$config_root" == /tmp/ds-* ]]; then
        failures+=("fault injected: plugin restore skipped (test roots only)")
      else
        rm -rf "$plugin_target" && restored=1 || failures+=("could not remove the partially written $plugin_target")
        if [[ -e "$backup_root/disk-steward-plugin" ]]; then
          mv "$backup_root/disk-steward-plugin" "$plugin_target" || failures+=("could not restore the previous plugin from $backup_root/disk-steward-plugin")
        fi
      fi
    fi
    if (( ${#failures} > 0 )); then
      manifest_finish "$backup_root" "restore-failed"
      print -u2 "install: step failed (exit $exit_status) and the automatic restore did not complete:"
      local failure
      for failure in "${failures[@]}"; do print -u2 "  - $failure"; done
      print -u2 "install: the pre-install copies stay in $backup_root; restore them with: $script_dir/rollback --client $client --config-root $config_root --backup ${backup_root:t} --force"
      exit_status=70
    elif (( restored )); then
      manifest_finish "$backup_root" "failed-and-restored"
      print -u2 "install: step failed (exit $exit_status); restored the $client configuration from $backup_root"
      print -u2 "install: nothing from this attempt remains; the backup stays in $backup_root"
    else
      manifest_finish "$backup_root" "refused-nothing-changed"
      print -u2 "install: step failed (exit $exit_status); nothing was changed"
    fi
  fi
  exit $exit_status
}
trap undo ZERR EXIT

manifest_begin "$backup_root" "install" "$client" "$connector"
if [[ -f "$config_file" ]]; then
  cp -p "$config_file" "$backup_root/${config_file:t}"
  manifest_file "$backup_root" "${config_file:t}" "$config_file" existed
  config_backed=1
else
  manifest_file "$backup_root" "${config_file:t}" "$config_file" absent
fi

if [[ "$client" == "codex" ]]; then
  if [[ -f "$config_file" ]]; then
    begins=$(grep -c '^# BEGIN DISK STEWARD MANAGED v1$' "$config_file" || true)
    ends=$(grep -c '^# END DISK STEWARD MANAGED v1$' "$config_file" || true)
    if (( begins != ends || begins > 1 )); then
      print -u2 "Refusing to edit $config_file because its Disk Steward managed markers are malformed."
      exit 65
    fi
  fi
  # One registration: the app's Agent Integrations writes the same
  # [mcp_servers.disk-steward] table through `codex mcp add`.
  if [[ -f "$config_file" ]] && awk '
      $0 == "# BEGIN DISK STEWARD MANAGED v1" { managed=1; next }
      $0 == "# END DISK STEWARD MANAGED v1" { managed=0; next }
      !managed && $0 ~ /^[ \t]*\[mcp_servers\.("disk-steward"|disk-steward)\][ \t]*$/ { found=1 }
      END { exit !found }
    ' "$config_file"; then
    print -u2 "Refusing to add a second disk-steward server: $config_file already has one, most likely from Disk Steward > Settings > Agent Integrations. Manage it there, or remove that entry first."
    exit 65
  fi
fi
skill_source="$repo_root/Integrations/Codex/disk-steward/skills/disk-steward-evidence"
mkdir -p "${plugin_target:h}"
if [[ -e "$plugin_target" ]]; then
  mv "$plugin_target" "$backup_root/disk-steward-plugin"
  manifest_plugin "$backup_root" existed
  plugin_backed=1
else
  manifest_plugin "$backup_root" absent
fi
cp -R "$skill_source" "$plugin_target"
plugin_written=1
if [[ "$client" == "codex" ]]; then
  # Earlier installs copied a plugin to <config-root>/plugins/disk-steward,
  # where Codex never loads plugins; it is moved into this backup.
  legacy_plugin="$config_root/plugins/disk-steward"
  if [[ -f "$legacy_plugin/.codex-plugin/plugin.json" ]]; then
    mv "$legacy_plugin" "$backup_root/legacy-codex-plugin"
    print "Moved the unused plugin copy from $legacy_plugin into $backup_root/legacy-codex-plugin."
  fi

  temporary=$(mktemp "$config_root/.config.toml.disk-steward.XXXXXX")
  if [[ -f "$config_file" ]]; then
    awk '
      $0 == "# BEGIN DISK STEWARD MANAGED v1" { managed=1; next }
      $0 == "# END DISK STEWARD MANAGED v1" { managed=0; next }
      !managed { print }
    ' "$config_file" > "$temporary"
    kept=$(<"$temporary")
    if [[ -n "$kept" ]]; then print -r -- "$kept" > "$temporary"; else : > "$temporary"; fi
  fi
  escaped=${connector//\\/\\\\}
  escaped=${escaped//\"/\\\"}
  {
    print ""
    print "# BEGIN DISK STEWARD MANAGED v1"
    print "[mcp_servers.disk-steward]"
    print "command = \"$escaped\""
    print "# END DISK STEWARD MANAGED v1"
  } >> "$temporary"
  chmod 600 "$temporary"
  # Check-and-swap: the file must still be the one that was backed up.
  if (( config_backed )); then
    verify_unchanged "$backup_root/${config_file:t}" "$config_file" || { rm -f "$temporary"; print -u2 "install: $config_file changed while it was being edited; nothing was changed. Retry."; exit 75; }
  elif [[ -e "$config_file" ]]; then
    rm -f "$temporary"; print -u2 "install: $config_file appeared while it was being edited; nothing was changed. Retry."; exit 75
  fi
  config_written=1
  mv "$temporary" "$config_file"
else
  config_written=1
  /usr/bin/swift "$script_dir/json-config.swift" set "$config_file" "$connector"
fi

manifest_after "$backup_root" "${config_file:t}" "$config_file"
manifest_finish "$backup_root" "installed"
prune_backups "$backups_dir" 10
trap - ZERR EXIT

print "Installed Disk Steward for $client in $config_root"
print "Backup: $backup_root"
print "Undo: $script_dir/rollback --client $client --config-root $config_root --backup $timestamp"
